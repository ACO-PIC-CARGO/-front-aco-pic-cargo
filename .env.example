# Front environment for a server build. Copy it to .env.production.local on the server, fill it in and build with
# `npm ci && npx vite build`; production mode turns on Sentry and the offline service worker (the demo VPS builds
# with `--mode development` and .env.development.local instead, which keeps both off).

# Base URL of the API with its trailing slash; every request is built as VITE_URL_MAIN + "route".
VITE_URL_MAIN=https://api.example.com/

# Must equal the "operativo" version the API answers in getVersion (table_version); otherwise the
# "Hemos mejorado ACO" update dialog keeps reopening.
VITE_VERSION=3.00

# Paddle Billing client-side token ("live_..." in production, "test_..." in sandbox) and its environment.
VITE_PADDLE_CLIENT_TOKEN=
VITE_PADDLE_ENV=production
