VITE_URL_MAIN=http://localhost:9200/

# Must equal the "operativo" version the API answers in getVersion (table_version); otherwise the
# "Hemos mejorado ACO" update dialog keeps reopening.
VITE_VERSION=3.01

# Paddle Billing client-side token ("live_..." in production, "test_..." in sandbox) and its environment.
VITE_PADDLE_CLIENT_TOKEN=
VITE_PADDLE_ENV=production